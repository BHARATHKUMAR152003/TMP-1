<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service on Windows hosts Node through iisnode. Every request is
  handed to the Express app, which serves the SPA (public/), the API and
  /uploads itself.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />

    <handlers>
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- iisnode's own diagnostics endpoint. -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^src/server.js\/debug[\/]?" />
        </rule>

        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url="src/server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Never expose source, dependencies or the log directory over HTTP. -->
    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="logs" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />

    <iisnode
      nodeProcessCountPerApplication="1"
      loggingEnabled="true"
      logDirectory="..\..\LogFiles\nodejs"
      devErrorsEnabled="false" />
  </system.webServer>
</configuration>
